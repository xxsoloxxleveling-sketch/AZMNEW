PORT=5000
NODE_ENV=development
# Database connection: PostgreSQL / Supabase pooler
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/azmaio_dev?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/azmaio_dev?schema=public"
JWT_ACCESS_SECRET="azmaio-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="azmaio-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
QR_SECRET="azmaio-school-qr-secret-key-2026"

# Cloudflare R2 Storage (Optional for local development; defaults to local backend/uploads fallback)
# Required in production:
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional R2 overrides:
R2_ENDPOINT=""
R2_REGION="auto"

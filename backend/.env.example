PORT=5000
NODE_ENV=development
# Runtime: use the Supabase transaction pooler with a deliberately small pool.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"
# Migrations only: use the Supabase direct connection (or session pooler when IPv4 is required).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_ACCESS_SECRET="azmaio-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="azmaio-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
QR_SECRET="azmaio-school-qr-secret-key-2026"

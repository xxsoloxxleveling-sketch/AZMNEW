{
  "name": "azmaio-backend",
  "version": "1.0.0",
  "description": "Backend API for AZM.AIO Management & Scholarship System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx puppeteer browsers install chrome && tsc",
    "start": "node --max-old-space-size=256 dist/server.js",
    "postinstall": "prisma generate && npx puppeteer browsers install chrome",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "storage:backfill": "tsx scripts/backfill-student-documents.ts",
    "test:egress": "tsx tests/egress-remediation.test.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "school-management",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "AZM",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pg-gateway": "^0.3.0-beta.4",
    "pg-mem": "^3.0.14",
    "prisma": "^5.22.0",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.8.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}

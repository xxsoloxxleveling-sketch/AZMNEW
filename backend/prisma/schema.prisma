datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum StudentDocumentAuditAction {
  UPLOADED
  REPLACED
  VERIFIED
  REJECTED
  REOPENED
}

model User {
  omrLegacyReviews OmrLegacyPublication[] @relation("OmrLegacyActor")
  omrExamsCreated OmrExam[] @relation("OmrExamCreator")
  omrPermissions OmrExamPermission[]
  omrKeysCreated OmrAnswerKeyRevision[] @relation("OmrKeyCreator")
  omrKeysApproved OmrAnswerKeyRevision[] @relation("OmrKeyApprover")
  omrUploads OmrScanBatch[] @relation("OmrUploader")
  omrResultsApproved OmrExamResult[] @relation("OmrResultApprover")
  omrCorrections OmrCorrectionAudit[] @relation("OmrCorrectionActor")
  omrPublications OmrPublicationAudit[] @relation("OmrPublicationActor")
  staff        Staff?
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  status       String   @default("ACTIVE")
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
}

enum ScholarshipCategory {
  GENERAL_MERIT
  FINANCIALLY_NEEDY
  ORPHAN
  PERSON_WITH_DISABILITY
}

model Student {
  omrLegacyReviews OmrLegacyPublication[]
  omrScans OmrScan[]
  omrExamResults OmrExamResult[]
  id                 String        @id @default(cuid())
  applicationNo      String        @unique
  studentId          String?       @unique
  registrationCentre String?
  rollNumber         String?       @unique
  qrToken            String        @unique
  qrImageUrl         String?
  photoUrl           String?
  uploadedDocsJson   String?
  assignedHallId     String?
  assignedHall       String?
  assignedRoom       String?
  seatNo             String?
  testScore          Int?
  overallRank        Int?
  resultSessionId    String?
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  // Part A: Personal Information
  fullName    String
  fatherName  String
  gender      Gender
  dateOfBirth DateTime
  age         Int?
  cnicOrBForm String   @unique
  nationality String   @default("Pakistani")
  religion    String?

  // Part B: Contact Information
  address       String
  district      String
  province      String
  studentMobile String?
  parentMobile  String
  whatsapp      String?
  email         String?

  // Part C: Educational Information
  currentClass      String
  hsscGroup         String?
  bsDepartment      String?
  bsSemester        String?
  schoolName        String
  boardOrUniversity String
  currentRollNo     String?

  // Part D: Scholarship Category
  scholarshipCategory ScholarshipCategory

  // Part E: Emergency & Family Information
  guardianOccupation    String?
  guardianMonthlyIncome Decimal?
  emergencyContact      String
  emergencyRelation     String

  // Part F: Declaration
  applicantSignedAt DateTime?
  parentSignedAt    DateTime?

  // Part I: Referral Source
  referralSource String?

  // Relations
  academicRecords  AcademicRecord[]
  documents        DocumentChecklist?
  officeUse        OfficeUseRecord?
  attendance       Attendance[]
  attendanceSessionCandidates AttendanceSessionCandidate[]
  feeRecords       FeeRecord[]
  studentDocuments StudentDocument[]
  studyGroupCorrections StudentStudyGroupCorrection[]
}

// Dedicated append-only correction evidence; no attendance/document audit reuse.
model StudentStudyGroupCorrection {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actorId String
  actorName String
  correctedAt DateTime @default(now())
  oldClass String
  newClass String
  oldGroup String?
  newGroup String?
  basis String
  previousUpdatedAt DateTime

  @@index([studentId, correctedAt])
}

model StudentDocument {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType     String
  bucket           String
  objectPath       String
  originalFileName String?
  mimeType         String
  byteSize         Int?
  checksumSha256   String?
  reviewStatus     DocumentReviewStatus @default(PENDING_REVIEW)
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedByName   String?
  rejectionReason  String?
  revision         Int @default(1)
  uploadedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([bucket, objectPath])
  @@index([studentId, documentType])
  @@index([reviewStatus, createdAt])
}

// Append-only historical record: deliberately no cascading FK to StudentDocument,
// so a removed student or replaced object cannot silently erase the audit trail.
model StudentDocumentAudit {
  id                 String @id @default(cuid())
  documentId         String
  studentId          String
  actorId            String
  actorName          String
  action             StudentDocumentAuditAction
  fromStatus         DocumentReviewStatus?
  toStatus           DocumentReviewStatus?
  reason             String?
  previousObjectPath String?
  previousBucket     String?
  previousFileName   String?
  previousMimeType   String?
  previousSha256     String?
  newObjectPath      String?
  newBucket          String?
  newFileName        String?
  newMimeType        String?
  newSha256          String?
  createdAt          DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([studentId, createdAt])
}

model AcademicRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examLevel     String
  boardOrUni    String?
  yearOfPassing String?
  totalMarks    Int?
  obtainedMarks Int?
  percentage    Decimal?
}

model DocumentChecklist {
  id                  String  @id @default(cuid())
  studentId           String  @unique
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bformCnicCopy       Boolean @default(false)
  fatherCnicCopy      Boolean @default(false)
  passportPhotos      Boolean @default(false)
  previousResultCard  Boolean @default(false)
  domicileCertificate Boolean @default(false)
  incomeCertificate   Boolean @default(false)
  otherDocuments      String?
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
}

enum FinalStatus {
  SHORTLISTED
  NOT_SHORTLISTED
  REJECTED
}

model OfficeUseRecord {
  id                 String             @id @default(cuid())
  studentId          String             @unique
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentVerifiedBy String?
  documentVerifiedAt DateTime?
  eligibility        EligibilityStatus?
  eligibilityRemarks String?
  testRollNo         String?
  testCentre         String?
  testReportingTime  String?
  testDate           DateTime?
  interviewDate      DateTime?
  interviewTime      String?
  panelNo            String?
  finalStatus        FinalStatus?
  officeRemarks      String?
  authorizedBy       String?
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  ACADEMY
  UNIVERSITY
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerInstitution {
  id                 String          @id @default(cuid())
  partnerCode        String          @unique
  applicationDate    DateTime        @default(now())
  institutionName    String
  institutionType    InstitutionType
  campus             String?
  address            String
  district           String
  province           String
  contactName        String
  contactDesignation String
  contactMobile      String
  contactWhatsapp    String?
  contactEmail       String?
  website            String?
  classesOffered     String[]
  studentStrength    Int?
  expectedApplicants Int?
  agreedToTerms      Boolean         @default(false)
  signedAt           DateTime?
  status             PartnerStatus   @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  statusAudits PartnerStatusAudit[]

  @@index([status])
  @@index([institutionType])
  @@index([district])
  @@index([createdAt])
  @@index([institutionName])
}

model PartnerCodeSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model PartnerStatusAudit {
  id             String             @id @default(cuid())
  partnerId      String
  partner        PartnerInstitution @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  previousStatus PartnerStatus
  newStatus      PartnerStatus
  reason         String?
  changedById    String?
  changedByEmail String?
  changedByName  String?
  changedAt      DateTime           @default(now())

  @@index([partnerId])
  @@index([changedAt])
}

model IdempotencyRecord {
  key         String   @id
  action      String
  payloadHash String?
  statusCode  Int
  response    String   @db.Text
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum AttendanceSessionStatus {
  PRE_OPEN
  OPEN
  CLOSED
  CANCELLED
}

model AttendanceSession {
  id                       String @id @default(cuid())
  attemptNumber            Int @default(1)
  isCurrent                Boolean @default(true)
  archivedAt               DateTime?
  examHallId               String
  examHall                 ExamHall @relation(fields: [examHallId], references: [id], onDelete: Restrict)
  businessDate             DateTime @db.Date
  status                   AttendanceSessionStatus @default(OPEN)
  openedByUserId           String?
  openedAt                 DateTime?
  preparedByUserId         String?
  revision                 Int @default(1)
  closedByUserId           String?
  closedAt                 DateTime?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  hallNameSnapshot         String
  roomNumberSnapshot       String
  testCenterNameSnapshot   String?
  examDateSnapshot         String
  reportingTimeSnapshot    String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  candidates               AttendanceSessionCandidate[]
  attendance               Attendance[]

  @@unique([examHallId, businessDate, attemptNumber])
  @@index([businessDate])
  @@index([status])
}

model AttendanceResetOperation {
  id             String @id @default(cuid())
  actorId        String
  actorName      String
  idempotencyKey String
  challengeNonce String @unique
  requestHash    String
  reason         String
  mode           String
  businessDate   DateTime @db.Date
  affectedCandidates Int
  scope          Json
  result         Json
  completedAt    DateTime @default(now())

  @@unique([actorId, idempotencyKey])
  @@index([completedAt])
}

// One sitting per center/business date. Student allocations remain exclusive current values.
model ExamPlacementControl {
  testCenterId String
  businessDate DateTime @db.Date
  frozen Boolean @default(false)
  revision Int @default(0)
  changedBy String?
  changedAt DateTime?
  reason String?
  @@id([testCenterId,businessDate])
}
model ExamAttemptSequence {
  examHallId String
  businessDate DateTime @db.Date
  generation Int
  @@id([examHallId,businessDate])
}
model ExamControlOperation {
  id String @id
  actorId String
  actorName String
  idempotencyKey String
  requestHash String
  nonce String @unique
  action String
  reason String
  scope Json
  result Json
  completedAt DateTime @default(now())
  @@unique([actorId,idempotencyKey])
}
model ExamLifecycleEvent {
  id String @id
  sessionId String
  examHallId String
  businessDate DateTime @db.Date
  testCenterId String?
  action String
  actorId String
  actorName String
  reason String
  occurredAt DateTime @default(now())
  @@index([testCenterId,businessDate,occurredAt])
}

model AttendanceSessionCancellation {
  id                          String @id
  sessionId                   String @unique
  actorId                     String
  actorName                   String
  idempotencyKey              String
  challengeNonce              String @unique
  requestHash                 String
  snapshotFingerprint         String
  reason                      String
  approvalReference           String?
  retentionApproved           Boolean @default(false)
  externalDispositionAttested Boolean @default(false)
  closedEvidenceApproved      Boolean @default(false)
  previousStatus              AttendanceSessionStatus
  businessDate                DateTime @db.Date
  purgeAttendance             Boolean
  markedCount                 Int
  deletedCount                Int
  retainedCount               Int
  expectedCount               Int
  cancelledAt                 DateTime @default(now())

  @@unique([actorId, idempotencyKey])
  @@index([cancelledAt])
}

// Immutable history of each authorized CLOSED -> OPEN transition.
model AttendanceSessionReopening {
  id                    String @id
  sessionId             String
  actorId               String
  actorName             String
  reason                String
  previousClosedAt      DateTime
  previousClosedByUserId String
  expectedCount         Int
  markedCount           Int
  reopenedAt            DateTime @default(now())

  @@index([sessionId, reopenedAt])
}

model AttendanceSessionCandidate {
  id                      String @id @default(cuid())
  sessionId               String
  session                 AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId               String
  student                 Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fullNameSnapshot        String
  rollNumberSnapshot      String?
  applicationNoSnapshot   String
  currentClassSnapshot    String
  seatNoSnapshot          String?
  createdAt               DateTime @default(now())
  attendance              Attendance? @relation("FrozenRosterAttendance")

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Attendance {
  id             String           @id @default(cuid())
  sessionId      String?
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  rosterCandidate AttendanceSessionCandidate? @relation("FrozenRosterAttendance", fields: [sessionId, studentId], references: [sessionId, studentId], onDelete: Restrict)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime         @default(now())
  status         AttendanceStatus
  markedByUserId String
  method         AttendanceMethod
  createdAt      DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model FeeRecord {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         String
  amountDue     Decimal
  amountPaid    Decimal   @default(0)
  status        FeeStatus @default(UNPAID)
  challanNumber String        @unique
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  transactions  Transaction[]
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  userId    String? @unique
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryPayments Transaction[]
  id        String          @id @default(cuid())
  fullName  String
  role      String
  cnic      String          @unique
  phone     String
  joinDate  DateTime
  salary    Decimal
  status    StaffStatus     @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  payroll   PayrollRecord[]
}

enum PayrollStatus {
  PENDING
  PAID
}

model PayrollRecord {
  id        String        @id @default(cuid())
  staffId   String
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  month     String
  amount    Decimal
  status    PayrollStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  transactions Transaction[]
}

enum TransactionType {
  FEE_INCOME
  SALARY_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum TransactionStatus {
  POSTED
  VOIDED
}

enum TransactionSource {
  STAFF_PAYMENT
  MANUAL
  FEE
  PAYROLL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  OTHER
}

model Transaction {
  id               String            @id @default(cuid())
  type             TransactionType
  amount           Decimal
  description      String
  transactionDate  DateTime          @default(now())
  status           TransactionStatus @default(POSTED)
  source           TransactionSource @default(MANUAL)
  category         String?
  paymentMethod    PaymentMethod?
  referenceNumber  String?

  // Operator / Creator metadata
  createdById      String?
  createdByName    String?
  createdByEmail   String?

  // Immutability / Void metadata
  voidedAt         DateTime?
  voidedById       String?
  voidedByName     String?
  voidedByEmail    String?
  voidReason       String?

  // Relations
  relatedStaffId   String?
  staff            Staff? @relation(fields: [relatedStaffId], references: [id], onDelete: Restrict)
  relatedFeeId     String?
  feeRecord        FeeRecord?        @relation(fields: [relatedFeeId], references: [id], onDelete: SetNull)
  relatedPayrollId String?
  payrollRecord    PayrollRecord?    @relation(fields: [relatedPayrollId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())

  @@index([transactionDate])
  @@index([createdAt])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([relatedFeeId])
  @@index([relatedPayrollId])
  @@index([relatedStaffId])
}

model TestCenter {
  id            String     @id @default(cuid())
  name          String
  code          String     @unique
  campus        String?
  address       String
  district      String
  province      String     @default("Khyber Pakhtunkhwa")
  capacity      Int        @default(300)
  reportingTime String     @default("09:00 AM")
  testDate      String     @default("Sunday, 15 November 2026")
  contactPerson String?
  contactPhone  String?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  examHalls     ExamHall[]
}

model ExamHall {
  id               String      @id @default(cuid())
  name             String
  roomNumber       String
  targetClass      String
  wing             String?
  capacity         Int         @default(60)
  invigilatorName  String?
  invigilatorPhone String?
  reportingTime    String      @default("09:00 AM")
  examDate         String      @default("Sunday, 15 November 2026")
  testCenterId     String?
  testCenter       TestCenter? @relation(fields: [testCenterId], references: [id], onDelete: SetNull)
  attendanceSessions AttendanceSession[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model GrievanceTicket {
  id           String          @id @default(cuid())
  ticketId     String          @unique
  name         String
  email        String?
  phone        String
  category     String
  cnicOrRollNo String?
  subject      String
  message      String
  status       GrievanceStatus @default(OPEN)
  response     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// OMR examination evidence is independent of attendance lifecycle attempts.
model OmrExam {
  id String @id @default(cuid())
  code String
  title String
  session String
  candidateGroup String
  examDate DateTime
  questionCount Int @default(100)
  correctMarks Decimal @default(1) @db.Decimal(12,4)
  incorrectPenalty Decimal @default(0) @db.Decimal(12,4)
  minimumScore Decimal? @db.Decimal(12,4)
  allowedVersions String[] @default(["A", "B", "C", "D"])
  status String @default("DRAFT")
  publicationStatus String @default("WITHHELD")
  releaseAt DateTime?
  createdBy String
  creator User @relation("OmrExamCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  keys OmrAnswerKeyRevision[]
  batches OmrScanBatch[]
  scans OmrScan[]
  results OmrExamResult[]
  permissions OmrExamPermission[]
  @@unique([code, candidateGroup])
  @@index([createdBy])
  @@index([status, examDate])
}

model OmrExamPermission {
  examId String
  userId String
  canScan Boolean @default(false)
  canReview Boolean @default(false)
  canManage Boolean @default(false)
  exam OmrExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([examId, userId])
  @@index([userId])
}

model OmrAnswerKeyRevision {
  id String @id @default(cuid())
  examId String
  candidateGroup String
  paperVersion String
  revision Int
  answers Json
  subjectMap Json?
  status String @default("DRAFT")
  isSynthetic Boolean @default(true)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  exam OmrExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  creator User @relation("OmrKeyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User? @relation("OmrKeyApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  results OmrExamResult[]
  @@unique([examId, candidateGroup, paperVersion, revision])
  @@index([createdBy])
  @@index([approvedBy])
}

model OmrScanBatch {
  attempts Int @default(0)
  lockedAt DateTime?
  lockedBy String?
  nextAttemptAt DateTime @default(now())
  errorCode String?
  id String @id @default(cuid())
  examId String
  uploadedBy String
  source String
  originalObjectKey String
  fileHash String
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  exam OmrExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  uploader User @relation("OmrUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  items OmrScanBatchItem[]
  @@index([examId, createdAt])
  @@index([uploadedBy])
  @@index([status, nextAttemptAt, createdAt], map: "OmrScanBatch_queue_idx")
}

model OmrScanBatchItem {
  id String @id @default(cuid())
  batchId String
  pageIndex Int
  scanId String?
  status String @default("QUEUED")
  errorCode String?
  batch OmrScanBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  scan OmrScan? @relation(fields: [scanId], references: [id], onDelete: Restrict)
  @@unique([batchId, pageIndex])
  @@index([scanId])
}

model OmrScan {
  id String @id @default(cuid())
  examId String
  studentId String?
  fileHash String
  pageIndex Int @default(1)
  originalObjectKey String
  annotationObjectKey String?
  templateVersion String?
  paperVersion String?
  status String @default("QUEUED")
  rawDetection Json?
  identityVerified Boolean @default(false)
  identityOverrideReason String?
  errorCode String?
  attempts Int @default(0)
  lockedAt DateTime?
  lockedBy String?
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  processedAt DateTime?
  exam OmrExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  items OmrScanBatchItem[]
  responses OmrDetectedResponse[]
  results OmrExamResult[]
  corrections OmrCorrectionAudit[]
  @@unique([examId, fileHash, pageIndex])
  @@index([status, nextAttemptAt, createdAt])
  @@index([studentId])
}

model OmrDetectedResponse {
  scanId String
  question Int
  detectedAnswer String
  reviewedAnswer String?
  evidence Json
  scan OmrScan @relation(fields: [scanId], references: [id], onDelete: Restrict)
  @@id([scanId, question])
}

model OmrExamResult {
  id String @id @default(cuid())
  examId String
  studentId String
  sourceScanId String
  answerKeyId String
  grade Json
  score Decimal @db.Decimal(12,4)
  maximumScore Decimal @db.Decimal(12,4)
  status String @default("DRAFT")
  rank Int?
  subjectScores Json?
  approvedBy String?
  approvedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam OmrExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  scan OmrScan @relation(fields: [sourceScanId], references: [id], onDelete: Restrict)
  key OmrAnswerKeyRevision @relation(fields: [answerKeyId], references: [id], onDelete: Restrict)
  approver User? @relation("OmrResultApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  publications OmrPublicationAudit[]
  @@unique([examId, studentId])
  @@index([studentId])
  @@index([sourceScanId])
  @@index([answerKeyId])
  @@index([approvedBy])
  @@index([examId, status])
}

model OmrCorrectionAudit {
  id String @id @default(cuid())
  scanId String
  actorId String
  question Int?
  previous Json
  next Json
  reason String
  createdAt DateTime @default(now())
  scan OmrScan @relation(fields: [scanId], references: [id], onDelete: Restrict)
  actor User @relation("OmrCorrectionActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([scanId, createdAt])
  @@index([actorId])
}

model OmrPublicationAudit {
  id String @id @default(cuid())
  resultId String
  actorId String
  action String
  snapshot Json
  reason String
  createdAt DateTime @default(now())
  result OmrExamResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  actor User @relation("OmrPublicationActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([resultId, createdAt])
  @@index([actorId])
}

// Explicit historical release decisions; no automatic score backfill or student rewrites.
model OmrLegacyPublication {
  id String @id @default(cuid())
  studentId String
  actorId String
  state String
  isSynthetic Boolean @default(true)
  snapshot Json
  evidenceReference String
  reason String
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actor User @relation("OmrLegacyActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([studentId, createdAt])
  @@index([actorId])
}

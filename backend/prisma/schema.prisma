datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  ACCOUNTANT
}

enum ExaminationPublicationStatus {
  DRAFT
  PUBLISHED
  WITHHELD
}

enum ExaminationResultIdentityStatus {
  PENDING
  VERIFIED
  MISMATCH
}

enum ExaminationResultScoringStatus {
  PROVISIONAL
  VERIFIED
}

enum ExaminationResultVerificationStatus {
  PENDING
  VERIFIED
  WITHHELD
}

enum ExaminationResultPublicationStatus {
  UNPUBLISHED
  PUBLISHED
  WITHHELD
}

enum ResultResponseClassification {
  CORRECT
  WRONG
  BLANK
  MULTIPLE
  UNCERTAIN
}

enum ResultResponseSource {
  OMR_DETECTED
  HUMAN_REVIEW
  ADMIN_CORRECTION
  MANUAL_ENTRY
}

enum ResultChangeSource {
  STUDENT_PROFILE
  RESULTS_DASHBOARD
  MANUAL_ENTRY
  EXAM_CONFIGURATION
  DMC_ISSUANCE
}

enum DmcDocumentType {
  ELECTRONIC
  OFFICIAL
}

enum DmcIssuanceEventType {
  ISSUED
  SUPERSEDED
  REVOKED
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum StudentDocumentAuditAction {
  UPLOADED
  REPLACED
  VERIFIED
  REJECTED
  REOPENED
}

model User {
  staff        Staff?
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  status       String   @default("ACTIVE")
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  createdExaminations Examination[] @relation("ExaminationCreator")
  publishedExaminations Examination[] @relation("ExaminationPublisher")
  examinationPublicationAudits ExaminationPublicationAudit[] @relation("ExaminationPublicationActor")
  createdPaperKeyRevisions ExaminationPaperKeyRevision[] @relation("PaperKeyRevisionCreator")
  examinationAudits ExaminationAudit[] @relation("ExaminationAuditActor")
  createdExaminationResults ExaminationResult[] @relation("ResultCreator")
  verifiedExaminationResults ExaminationResult[] @relation("ResultVerifier")
  publishedExaminationResults ExaminationResult[] @relation("ResultPublisher")
  resultCorrectionAudits ResultCorrectionAudit[] @relation("ResultCorrectionActor")
  dmcPreparations DmcIssuancePreparation[] @relation("DmcPreparationActor")
  issuedDmcDocuments DmcIssuance[] @relation("DmcIssuer")
  dmcIssuanceEvents DmcIssuanceEvent[] @relation("DmcEventActor")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
}

enum ScholarshipCategory {
  GENERAL_MERIT
  FINANCIALLY_NEEDY
  ORPHAN
  PERSON_WITH_DISABILITY
}

model Student {
  id                 String        @id @default(cuid())
  applicationNo      String        @unique
  studentId          String?       @unique
  registrationCentre String?
  rollNumber         String?       @unique
  qrToken            String        @unique
  qrImageUrl         String?
  photoUrl           String?
  uploadedDocsJson   String?
  assignedHallId     String?
  assignedHall       String?
  assignedRoom       String?
  seatNo             String?
  testScore          Int?
  overallRank        Int?
  resultSessionId    String?
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  // Part A: Personal Information
  fullName    String
  fatherName  String
  gender      Gender
  dateOfBirth DateTime
  age         Int?
  cnicOrBForm String   @unique
  nationality String   @default("Pakistani")
  religion    String?

  // Part B: Contact Information
  address       String
  district      String
  province      String
  studentMobile String?
  parentMobile  String
  whatsapp      String?
  email         String?

  // Part C: Educational Information
  currentClass      String
  hsscGroup         String?
  bsDepartment      String?
  bsSemester        String?
  schoolName        String
  boardOrUniversity String
  currentRollNo     String?

  // Part D: Scholarship Category
  scholarshipCategory ScholarshipCategory

  // Part E: Emergency & Family Information
  guardianOccupation    String?
  guardianMonthlyIncome Decimal?
  emergencyContact      String
  emergencyRelation     String

  // Part F: Declaration
  applicantSignedAt DateTime?
  parentSignedAt    DateTime?

  // Part I: Referral Source
  referralSource String?

  // Relations
  academicRecords  AcademicRecord[]
  documents        DocumentChecklist?
  officeUse        OfficeUseRecord?
  attendance       Attendance[]
  attendanceSessionCandidates AttendanceSessionCandidate[]
  feeRecords       FeeRecord[]
  studentDocuments StudentDocument[]
  studyGroupCorrections StudentStudyGroupCorrection[]
  examinationResults ExaminationResult[]
  legacyExamResultHistory ExamLegacyResultHistory[]
}

// Dedicated append-only correction evidence; no attendance/document audit reuse.
model StudentStudyGroupCorrection {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actorId String
  actorName String
  correctedAt DateTime @default(now())
  oldClass String
  newClass String
  oldGroup String?
  newGroup String?
  basis String
  previousUpdatedAt DateTime

  @@index([studentId, correctedAt])
}

model StudentDocument {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType     String
  bucket           String
  objectPath       String
  originalFileName String?
  mimeType         String
  byteSize         Int?
  checksumSha256   String?
  reviewStatus     DocumentReviewStatus @default(PENDING_REVIEW)
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedByName   String?
  rejectionReason  String?
  revision         Int @default(1)
  uploadedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([bucket, objectPath])
  @@index([studentId, documentType])
  @@index([reviewStatus, createdAt])
}

// Append-only historical record: deliberately no cascading FK to StudentDocument,
// so a removed student or replaced object cannot silently erase the audit trail.
model StudentDocumentAudit {
  id                 String @id @default(cuid())
  documentId         String
  studentId          String
  actorId            String
  actorName          String
  action             StudentDocumentAuditAction
  fromStatus         DocumentReviewStatus?
  toStatus           DocumentReviewStatus?
  reason             String?
  previousObjectPath String?
  previousBucket     String?
  previousFileName   String?
  previousMimeType   String?
  previousSha256     String?
  newObjectPath      String?
  newBucket          String?
  newFileName        String?
  newMimeType        String?
  newSha256          String?
  createdAt          DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([studentId, createdAt])
}

model AcademicRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examLevel     String
  boardOrUni    String?
  yearOfPassing String?
  totalMarks    Int?
  obtainedMarks Int?
  percentage    Decimal?
}

model DocumentChecklist {
  id                  String  @id @default(cuid())
  studentId           String  @unique
  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bformCnicCopy       Boolean @default(false)
  fatherCnicCopy      Boolean @default(false)
  passportPhotos      Boolean @default(false)
  previousResultCard  Boolean @default(false)
  domicileCertificate Boolean @default(false)
  incomeCertificate   Boolean @default(false)
  otherDocuments      String?
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
}

enum FinalStatus {
  SHORTLISTED
  NOT_SHORTLISTED
  REJECTED
}

model OfficeUseRecord {
  id                 String             @id @default(cuid())
  studentId          String             @unique
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentVerifiedBy String?
  documentVerifiedAt DateTime?
  eligibility        EligibilityStatus?
  eligibilityRemarks String?
  testRollNo         String?
  testCentre         String?
  testReportingTime  String?
  testDate           DateTime?
  interviewDate      DateTime?
  interviewTime      String?
  panelNo            String?
  finalStatus        FinalStatus?
  officeRemarks      String?
  authorizedBy       String?
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  ACADEMY
  UNIVERSITY
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerInstitution {
  id                 String          @id @default(cuid())
  partnerCode        String          @unique
  applicationDate    DateTime        @default(now())
  institutionName    String
  institutionType    InstitutionType
  campus             String?
  address            String
  district           String
  province           String
  contactName        String
  contactDesignation String
  contactMobile      String
  contactWhatsapp    String?
  contactEmail       String?
  website            String?
  classesOffered     String[]
  studentStrength    Int?
  expectedApplicants Int?
  agreedToTerms      Boolean         @default(false)
  signedAt           DateTime?
  status             PartnerStatus   @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  statusAudits PartnerStatusAudit[]

  @@index([status])
  @@index([institutionType])
  @@index([district])
  @@index([createdAt])
  @@index([institutionName])
}

model PartnerCodeSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model PartnerStatusAudit {
  id             String             @id @default(cuid())
  partnerId      String
  partner        PartnerInstitution @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  previousStatus PartnerStatus
  newStatus      PartnerStatus
  reason         String?
  changedById    String?
  changedByEmail String?
  changedByName  String?
  changedAt      DateTime           @default(now())

  @@index([partnerId])
  @@index([changedAt])
}

model IdempotencyRecord {
  key         String   @id
  action      String
  payloadHash String?
  statusCode  Int
  response    String   @db.Text
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum AttendanceSessionStatus {
  PRE_OPEN
  OPEN
  CLOSED
  CANCELLED
}

model AttendanceSession {
  id                       String @id @default(cuid())
  attemptNumber            Int @default(1)
  isCurrent                Boolean @default(true)
  archivedAt               DateTime?
  examHallId               String
  examHall                 ExamHall @relation(fields: [examHallId], references: [id], onDelete: Restrict)
  businessDate             DateTime @db.Date
  status                   AttendanceSessionStatus @default(OPEN)
  openedByUserId           String?
  openedAt                 DateTime?
  preparedByUserId         String?
  revision                 Int @default(1)
  closedByUserId           String?
  closedAt                 DateTime?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  hallNameSnapshot         String
  roomNumberSnapshot       String
  testCenterNameSnapshot   String?
  examDateSnapshot         String
  reportingTimeSnapshot    String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  candidates               AttendanceSessionCandidate[]
  attendance               Attendance[]
  legacyExamResultHistory  ExamLegacyResultHistory[]

  @@unique([examHallId, businessDate, attemptNumber])
  @@index([businessDate])
  @@index([status])
}

model ExamLegacyResultHistory {
  sessionId       String
  studentId       String
  testScore       Int?
  overallRank     Int?
  resetOperationId String?
  source          String @default("CONTROL")
  archivedAt      DateTime @default(now())
  session         AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student         Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  operation       ExamControlOperation? @relation(fields: [resetOperationId], references: [id], onDelete: Restrict)

  @@id([sessionId, studentId])
}

model AttendanceResetOperation {
  id             String @id @default(cuid())
  actorId        String
  actorName      String
  idempotencyKey String
  challengeNonce String @unique
  requestHash    String
  reason         String
  mode           String
  businessDate   DateTime @db.Date
  affectedCandidates Int
  scope          Json
  result         Json
  completedAt    DateTime @default(now())

  @@unique([actorId, idempotencyKey])
  @@index([completedAt])
}

// One sitting per center/business date. Student allocations remain exclusive current values.
model ExamPlacementControl {
  testCenterId String
  businessDate DateTime @db.Date
  frozen Boolean @default(false)
  revision Int @default(0)
  changedBy String?
  changedAt DateTime?
  reason String?
  @@id([testCenterId,businessDate])
}
model ExamAttemptSequence {
  examHallId String
  businessDate DateTime @db.Date
  generation Int
  @@id([examHallId,businessDate])
}
model ExamControlOperation {
  id String @id
  actorId String
  actorName String
  idempotencyKey String
  requestHash String
  nonce String @unique
  action String
  reason String
  scope Json
  result Json
  completedAt DateTime @default(now())
  legacyExamResultHistory ExamLegacyResultHistory[]
  @@unique([actorId,idempotencyKey])
}
model ExamLifecycleEvent {
  id String @id
  sessionId String
  examHallId String
  businessDate DateTime @db.Date
  testCenterId String?
  action String
  actorId String
  actorName String
  reason String
  occurredAt DateTime @default(now())
  @@index([testCenterId,businessDate,occurredAt])
}

model AttendanceSessionCancellation {
  id                          String @id
  sessionId                   String @unique
  actorId                     String
  actorName                   String
  idempotencyKey              String
  challengeNonce              String @unique
  requestHash                 String
  snapshotFingerprint         String
  reason                      String
  approvalReference           String?
  retentionApproved           Boolean @default(false)
  externalDispositionAttested Boolean @default(false)
  closedEvidenceApproved      Boolean @default(false)
  previousStatus              AttendanceSessionStatus
  businessDate                DateTime @db.Date
  purgeAttendance             Boolean
  markedCount                 Int
  deletedCount                Int
  retainedCount               Int
  expectedCount               Int
  cancelledAt                 DateTime @default(now())

  @@unique([actorId, idempotencyKey])
  @@index([cancelledAt])
}

// Immutable history of each authorized CLOSED -> OPEN transition.
model AttendanceSessionReopening {
  id                    String @id
  sessionId             String
  actorId               String
  actorName             String
  reason                String
  previousClosedAt      DateTime
  previousClosedByUserId String
  expectedCount         Int
  markedCount           Int
  reopenedAt            DateTime @default(now())

  @@index([sessionId, reopenedAt])
}

model AttendanceSessionCandidate {
  id                      String @id @default(cuid())
  sessionId               String
  session                 AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId               String
  student                 Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fullNameSnapshot        String
  rollNumberSnapshot      String?
  applicationNoSnapshot   String
  currentClassSnapshot    String
  seatNoSnapshot          String?
  createdAt               DateTime @default(now())
  attendance              Attendance? @relation("FrozenRosterAttendance")

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Attendance {
  id             String           @id @default(cuid())
  sessionId      String?
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  rosterCandidate AttendanceSessionCandidate? @relation("FrozenRosterAttendance", fields: [sessionId, studentId], references: [sessionId, studentId], onDelete: Restrict)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime         @default(now())
  status         AttendanceStatus
  markedByUserId String
  method         AttendanceMethod
  createdAt      DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model FeeRecord {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         String
  amountDue     Decimal
  amountPaid    Decimal   @default(0)
  status        FeeStatus @default(UNPAID)
  challanNumber String        @unique
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  transactions  Transaction[]
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  userId    String? @unique
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryPayments Transaction[]
  id        String          @id @default(cuid())
  fullName  String
  role      String
  cnic      String          @unique
  phone     String
  joinDate  DateTime
  salary    Decimal
  status    StaffStatus     @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  payroll   PayrollRecord[]
}

enum PayrollStatus {
  PENDING
  PAID
}

model PayrollRecord {
  id        String        @id @default(cuid())
  staffId   String
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  month     String
  amount    Decimal
  status    PayrollStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  transactions Transaction[]
}

enum TransactionType {
  FEE_INCOME
  SALARY_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum TransactionStatus {
  POSTED
  VOIDED
}

enum TransactionSource {
  STAFF_PAYMENT
  MANUAL
  FEE
  PAYROLL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ONLINE
  OTHER
}

model Transaction {
  id               String            @id @default(cuid())
  type             TransactionType
  amount           Decimal
  description      String
  transactionDate  DateTime          @default(now())
  status           TransactionStatus @default(POSTED)
  source           TransactionSource @default(MANUAL)
  category         String?
  paymentMethod    PaymentMethod?
  referenceNumber  String?

  // Operator / Creator metadata
  createdById      String?
  createdByName    String?
  createdByEmail   String?

  // Immutability / Void metadata
  voidedAt         DateTime?
  voidedById       String?
  voidedByName     String?
  voidedByEmail    String?
  voidReason       String?

  // Relations
  relatedStaffId   String?
  staff            Staff? @relation(fields: [relatedStaffId], references: [id], onDelete: Restrict)
  relatedFeeId     String?
  feeRecord        FeeRecord?        @relation(fields: [relatedFeeId], references: [id], onDelete: SetNull)
  relatedPayrollId String?
  payrollRecord    PayrollRecord?    @relation(fields: [relatedPayrollId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())

  @@index([transactionDate])
  @@index([createdAt])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([relatedFeeId])
  @@index([relatedPayrollId])
  @@index([relatedStaffId])
}

model TestCenter {
  id            String     @id @default(cuid())
  name          String
  code          String     @unique
  campus        String?
  address       String
  district      String
  province      String     @default("Khyber Pakhtunkhwa")
  capacity      Int        @default(300)
  reportingTime String     @default("09:00 AM")
  testDate      String     @default("Sunday, 15 November 2026")
  contactPerson String?
  contactPhone  String?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  examHalls     ExamHall[]
}

model ExamHall {
  id               String      @id @default(cuid())
  name             String
  roomNumber       String
  targetClass      String
  wing             String?
  capacity         Int         @default(60)
  invigilatorName  String?
  invigilatorPhone String?
  reportingTime    String      @default("09:00 AM")
  examDate         String      @default("Sunday, 15 November 2026")
  testCenterId     String?
  testCenter       TestCenter? @relation(fields: [testCenterId], references: [id], onDelete: SetNull)
  attendanceSessions AttendanceSession[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
}

enum GrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model GrievanceTicket {
  id           String          @id @default(cuid())
  ticketId     String          @unique
  name         String
  email        String?
  phone        String
  category     String
  cnicOrRollNo String?
  subject      String
  message      String
  status       GrievanceStatus @default(OPEN)
  response     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Exam-specific official results are deliberately separate from legacy Student.testScore.
model Examination {
  id                 String                       @id @default(cuid())
  reference          String                       @unique
  title              String
  sessionReference   String
  examDate           DateTime?                    @db.Date
  classGroup         String
  maximumMarks       Decimal                      @db.Decimal(8, 2)
  questionCount      Int
  scoringPolicy      Json
  publicationStatus  ExaminationPublicationStatus @default(DRAFT)
  publishedAt        DateTime?
  publishedById      String?
  revision           Int                          @default(1)
  createdById        String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  createdBy          User                         @relation("ExaminationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy        User?                        @relation("ExaminationPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  results            ExaminationResult[]
  audits             ExaminationAudit[]
  publicationAudits  ExaminationPublicationAudit[]
  paperKeyRevisions  ExaminationPaperKeyRevision[]

  @@index([publicationStatus, examDate])
  @@index([classGroup, sessionReference])
}

model ExaminationResult {
  id                             String                              @id @default(cuid())
  resultReference                String                              @unique
  studentId                      String
  examinationId                  String
  sourceScanReference            String?                             @unique
  paperVersion                   String?
  obtainedMarks                  Decimal?                            @db.Decimal(8, 2)
  maximumMarks                   Decimal                             @db.Decimal(8, 2)
  correctCount                   Int?
  wrongCount                     Int?
  blankCount                     Int?
  multipleCount                  Int?
  uncertainCount                 Int?
  identityStatus                 ExaminationResultIdentityStatus    @default(PENDING)
  scoringStatus                  ExaminationResultScoringStatus     @default(PROVISIONAL)
  verificationStatus             ExaminationResultVerificationStatus @default(PENDING)
  publicationStatus              ExaminationResultPublicationStatus @default(UNPUBLISHED)
  resultRevision                 Int                                 @default(1)
  administrativelyAdjusted       Boolean                             @default(false)
  administrativeAdjustmentReason String?                             @db.Text
  administrativeRemarks          String?                             @db.Text
  verifiedAt                     DateTime?
  verifiedById                   String?
  publishedAt                    DateTime?
  publishedById                  String?
  createdById                    String
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  student                        Student                             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examination                    Examination                         @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  createdBy                      User                                @relation("ResultCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy                     User?                               @relation("ResultVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  publishedBy                    User?                               @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  responses                      ResultQuestionResponse[]
  corrections                    ResultCorrectionAudit[]
  dmcPreparations                DmcIssuancePreparation[]
  dmcIssuances                   DmcIssuance[]

  @@unique([studentId, examinationId])
  @@index([examinationId, publicationStatus, verificationStatus])
  @@index([studentId, createdAt])
  @@index([updatedAt])
}

model ResultQuestionResponse {
  id               String                       @id @default(cuid())
  resultId         String
  questionNumber   Int
  detectedAnswer   String?
  reviewedAnswer   String?
  classification   ResultResponseClassification
  marksAwarded     Decimal?                     @db.Decimal(8, 2)
  responseSource   ResultResponseSource
  reviewMetadata   Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  result           ExaminationResult            @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@unique([resultId, questionNumber])
  @@index([resultId, classification])
}

// Insert-only audit evidence. The migration installs triggers that reject UPDATE/DELETE.
model ResultCorrectionAudit {
  id                String            @id @default(cuid())
  resultId          String
  studentId         String
  examinationId     String
  previousRevision  Int
  newRevision       Int
  oldValues         Json
  newValues         Json
  reason            String            @db.Text
  actorId           String
  actorName         String
  source            ResultChangeSource
  publicationImpact String
  occurredAt        DateTime          @default(now())
  result            ExaminationResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  actor             User              @relation("ResultCorrectionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([resultId, occurredAt])
  @@index([studentId, examinationId, occurredAt])
}

model ExaminationAudit {
  id                String            @id @default(cuid())
  examinationId     String
  previousValues    Json
  newValues         Json
  reason            String            @db.Text
  actorId           String
  actorName         String
  source            ResultChangeSource
  occurredAt        DateTime          @default(now())
  examination       Examination       @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  actor             User              @relation("ExaminationAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([examinationId, occurredAt])
}

model ExaminationPublicationAudit {
  id               String                       @id @default(cuid())
  examinationId    String
  previousStatus   ExaminationPublicationStatus
  newStatus        ExaminationPublicationStatus
  previousRevision Int
  newRevision      Int
  reason           String                       @db.Text
  actorId          String
  actorName        String
  occurredAt       DateTime                     @default(now())
  examination      Examination                  @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  actor            User                         @relation("ExaminationPublicationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([examinationId, occurredAt])
}

// Stores only non-secret key revision identifiers; answer-key contents stay outside this model.
model ExaminationPaperKeyRevision {
  id                String      @id @default(cuid())
  examinationId     String
  paperVersion      String
  answerKeyRevision String
  createdById       String
  createdAt         DateTime    @default(now())
  examination       Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  createdBy         User        @relation("PaperKeyRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([examinationId, paperVersion])
  @@index([examinationId, createdAt])
}

model DmcIssuancePreparation {
  id                String            @id
  resultId          String
  resultRevision    Int
  snapshot          Json
  actorId           String
  actorName         String
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  result            ExaminationResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  actor             User              @relation("DmcPreparationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([resultId, expiresAt])
  @@index([actorId, expiresAt])
}

// Issued document snapshots never change; transitions are separate append-only events.
model DmcIssuance {
  id                    String            @id
  resultId              String
  documentType          DmcDocumentType
  resultRevision        Int
  issueNumber           Int
  certificateNumber     String            @unique
  verificationReference String            @unique
  snapshot              Json
  idempotencyKey        String
  issuedById            String
  issuedByName          String
  issuedAt              DateTime          @default(now())
  result                ExaminationResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  issuedBy              User              @relation("DmcIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  events                DmcIssuanceEvent[]

  @@unique([resultId, documentType, issueNumber])
  @@unique([issuedById, idempotencyKey])
  @@index([resultId, issuedAt])
}

model DmcIssuanceEvent {
  id          String                @id @default(cuid())
  issuanceId  String
  eventType   DmcIssuanceEventType
  reason      String?               @db.Text
  actorId     String
  actorName   String
  occurredAt  DateTime              @default(now())
  issuance    DmcIssuance           @relation(fields: [issuanceId], references: [id], onDelete: Restrict)
  actor       User                  @relation("DmcEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([issuanceId, occurredAt])
}
